{
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    {
      "source": "/static/build/out/vs/workbench/workbench.web.main.css",
      "destination": "/static/build/out/vs/workbench/workbench.web.main.internal.css"
    },
    {
      "source": "/auth",
      "destination": "/static/build/auth.html"
    },
    {
      "source": "/callback",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/static/build/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ]
}
